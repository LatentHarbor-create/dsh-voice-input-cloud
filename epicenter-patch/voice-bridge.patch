diff --git a/apps/epicenter/src-tauri/src/bridge/mod.rs b/apps/epicenter/src-tauri/src/bridge/mod.rs
new file mode 100644
index 0000000..cd175c8
--- /dev/null
+++ b/apps/epicenter/src-tauri/src/bridge/mod.rs
@@ -0,0 +1,167 @@
+//! The voice bridge: one loopback HTTP surface an OS process (the DSH voice
+//! bridge, then the DeepSeek Harness voice input plugin) may reach to drive the
+//! host's existing recorder and local transcription engine.
+//!
+//! Why this exists: the seven `PUBLIC_CLIENT_COMMANDS` are Tauri IPC, callable
+//! only from a trusted WebView. A non-WebView caller — a plain OS process —
+//! has no supported entry. This module adds exactly one, deliberately narrow:
+//! start, stop, cancel, transcribe, health. It reuses [`crate::recorder`] and
+//! [`crate::transcription`] as they are; no pipeline, setting, or delivery
+//! path changes, and `apps/whispering` stays untouched.
+//!
+//! Security shape (all four are load-bearing):
+//! - binds 127.0.0.1 on an OS-assigned port, never a fixed or remote one;
+//! - one credential per launch (32 random bytes, URL-safe base64), written to
+//!   `<app_config_dir>/voice-bridge.json` so the local bridge process can read
+//!   it from the user profile it already owns — never logged, never in a URL;
+//! - every request requires `Authorization: Bearer <token>` and a `Host`
+//!   header of exactly `127.0.0.1:<port>` (DNS-rebinding fence);
+//! - request bodies are capped, and logs carry only request ids, state
+//!   transitions, durations, and error classes — never transcript text.
+//!
+//! The surface is additive and removable: `spawn` is called once from
+//! `setup`, and every failure inside it degrades the bridge to "absent"
+//! rather than failing the host.
+
+mod server;
+
+use base64::engine::general_purpose::URL_SAFE_NO_PAD;
+use base64::Engine;
+use std::net::TcpListener;
+use tauri::AppHandle;
+use tauri::Manager;
+
+/// This launch's credential, stored at spawn and read by every request's
+/// auth check. A `OnceLock` rather than managed state so the auth fence
+/// stays a pure function of the header bytes.
+static TOKEN: std::sync::OnceLock<String> = std::sync::OnceLock::new();
+
+pub(crate) fn current_token() -> &'static str {
+    TOKEN.get().map(String::as_str).unwrap_or("")
+}
+
+/// How many bytes of request body the surface will read. Transcription hints
+/// are sentences, not documents; anything larger is not a voice request.
+const MAX_BODY_BYTES: u64 = 64 * 1024;
+
+/// Independent worker threads. Handlers block on the recorder mutex exactly
+/// like the Tauri commands do, and transcription blocks its worker for the
+/// length of an inference run, so one slow request must not strand the others.
+const WORKER_THREADS: usize = 4;
+
+/// The name recordings started here carry. The recorder's ownership checks
+/// compare this against the caller on every stop/cancel, so a recording
+/// started by the bridge can only ever be resolved by the bridge — a window
+/// that names it gets the same typed refusal a bridge would get for theirs.
+pub(crate) const OWNER_LABEL: &str = "voice-bridge";
+
+/// Generate this launch's credential: 32 random bytes, URL-safe base64.
+fn launch_token() -> Result<String, Box<dyn std::error::Error + Send + Sync>> {
+    let mut bytes = [0_u8; 32];
+    getrandom::fill(&mut bytes)
+        .map_err(|error| format!("generate the voice-bridge credential: {error}"))?;
+    Ok(URL_SAFE_NO_PAD.encode(bytes))
+}
+
+/// Bind, publish the discovery file, and start the workers. Every failure is
+/// logged and swallowed: the bridge is an addition to the host, never a
+/// precondition of it.
+pub fn spawn(app: AppHandle) {
+    if let Err(error) = spawn_inner(app) {
+        log::error!("voice-bridge: surface disabled, {error:#}");
+    }
+}
+
+fn spawn_inner(app: AppHandle) -> Result<(), Box<dyn std::error::Error + Send + Sync>> {
+    let token = launch_token()?;
+    TOKEN.set(token.clone())
+        .map_err(|_| "voice-bridge credential already set")?;
+
+    // Reserve a free port first so the discovery file can carry the real
+    // port before the workers start serving.
+    let probe = TcpListener::bind(("127.0.0.1", 0))?;
+    let port = probe.local_addr()?.port();
+    drop(probe);
+
+    // The fence compares the Host header against the listener's own address.
+    server::store_server_addr(format!("127.0.0.1:{port}"));
+
+    let server = tiny_http::Server::http(("127.0.0.1", port))
+        .map_err(|error| format!("bind the voice-bridge listener: {error}"))?;
+
+    // The discovery file: the one fact a local process needs to reach this
+    // surface. Written through a temporary + rename so a reader never sees a
+    // half-written credential.
+    let config_dir = match std::env::var_os("EPICENTER_DATA_DIR") {
+        Some(value) if !value.is_empty() => crate::app_data::epicenter_data_root(&app)
+            .map_err(|_| "resolve the configured Epicenter data root")?,
+        _ => app
+            .path()
+            .app_config_dir()
+            .map_err(|_| "resolve the app config dir")?,
+    };
+    std::fs::create_dir_all(&config_dir)
+        .map_err(|error| format!("create the app config dir: {error}"))?;
+    let discovery_path = config_dir.join("voice-bridge.json");
+    let tmp_path = config_dir.join("voice-bridge.json.tmp");
+    let discovery = serde_json::json!({ "port": port, "token": token });
+    std::fs::write(&tmp_path, discovery.to_string())
+        .map_err(|error| format!("write the discovery temp file: {error}"))?;
+    std::fs::rename(&tmp_path, &discovery_path)
+        .map_err(|error| format!("publish the discovery file: {error}"))?;
+
+    // The token itself is deliberately absent from the log: the log is
+    // readable by anything the user can read, and the discovery file is the
+    // only intended channel.
+    log::info!(
+        "voice-bridge: listening on 127.0.0.1:{port}; discovery file: {}",
+        discovery_path.display()
+    );
+
+    let server = std::sync::Arc::new(server);
+    for worker in 0..WORKER_THREADS {
+        let server = server.clone();
+        let app = app.clone();
+        std::thread::Builder::new()
+            .name(format!("voice-bridge-{worker}"))
+            .spawn(move || loop {
+                match server.recv() {
+                    Ok(request) => server::handle(&app, request),
+                    Err(error) => {
+                        log::warn!("voice-bridge: request receive failed: {error}");
+                    }
+                }
+            })
+            .map_err(|error| format!("spawn a voice-bridge worker: {error}"))?;
+    }
+
+    Ok(())
+}
+
+/// The per-launch token, read back for tests.
+#[cfg(test)]
+pub(crate) fn token_bytes(n: usize) -> String {
+    let mut bytes = vec![0_u8; n];
+    getrandom::fill(&mut bytes).expect("fill from the OS rng");
+    URL_SAFE_NO_PAD.encode(bytes)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn launch_token_is_url_safe_and_roughly_long() {
+        let token = launch_token().expect("token");
+        assert!(!token.contains('+'));
+        assert!(!token.contains('/'));
+        assert!(!token.contains('='));
+        // 32 bytes -> 43 base64url chars without padding.
+        assert_eq!(token.len(), 43);
+    }
+
+    #[test]
+    fn tokens_differ_across_calls() {
+        assert_ne!(token_bytes(32), token_bytes(32));
+    }
+}
diff --git a/apps/epicenter/src-tauri/src/bridge/server.rs b/apps/epicenter/src-tauri/src/bridge/server.rs
new file mode 100644
index 0000000..170b000
--- /dev/null
+++ b/apps/epicenter/src-tauri/src/bridge/server.rs
@@ -0,0 +1,372 @@
+//! The voice bridge's request plane: routing, the auth fence, JSON bodies,
+//! and the mapping from the host's typed errors to HTTP responses.
+//!
+//! Structure note: everything that touches host state lives in [`route`];
+//! everything that can be tested without a Tauri app (the fence, body
+//! parsing, error mapping, request-id echoing) is a pure function at the
+//! bottom of this file, and the unit tests exercise those.
+
+use super::{OWNER_LABEL, MAX_BODY_BYTES};
+use serde_json::{json, Value};
+use std::io::Read;
+use std::time::Instant;
+use tauri::AppHandle;
+use tauri::Manager;
+use base64::Engine as _;
+
+/// The result of one handled request: an HTTP status plus the JSON body.
+type Answer = (u16, Value);
+
+pub fn handle(app: &AppHandle, mut request: tiny_http::Request) {
+    let started = Instant::now();
+    let method = match request.method().as_str() {
+        "GET" => "GET",
+        "POST" => "POST",
+        "OPTIONS" => "OPTIONS",
+        _ => "OTHER",
+    };
+    let route_label = match request.url().split('?').next().unwrap_or("") {
+        "/health" => "/health",
+        "/start" => "/start",
+        "/stop" => "/stop",
+        "/cancel" => "/cancel",
+        "/audio" => "/audio",
+        "/transcribe" => "/transcribe",
+        _ => "(unknown route)",
+    };
+
+    let (status, body) = route(app, &mut request);
+    let body_string = body.to_string();
+
+    // Logs carry known route labels, status, duration, and nothing
+    // about content. Audio and transcript bytes never enter a log line.
+    log::info!(
+        "voice-bridge: {method} {route_label} -> {status} ({} ms, {} bytes)",
+        started.elapsed().as_millis(),
+        body_string.len()
+    );
+
+    let response = tiny_http::Response::from_string(body_string)
+        .with_status_code(tiny_http::StatusCode(status))
+        .with_header(
+            tiny_http::Header::from_bytes(&b"Content-Type"[..], &b"application/json"[..])
+                .expect("static header"),
+        );
+    let _ = request.respond(response);
+}
+
+fn route(app: &AppHandle, request: &mut tiny_http::Request) -> Answer {
+    let path = request.url().split('?').next().unwrap_or("").to_owned();
+    let method = request.method().clone();
+
+    // The fence: every request authenticates, and names the exact loopback
+    // origin in its Host header (a browser-side DNS-rebinding attempt would
+    // fail here before touching state).
+    if let Err(answer) = authorize(request) {
+        return answer;
+    }
+
+    let body = match read_body(request) {
+        Ok(body) => body,
+        Err(answer) => return answer,
+    };
+
+    let parsed: Value = if body.is_empty() {
+        json!({})
+    } else {
+        match serde_json::from_slice(&body) {
+            Ok(value) => value,
+            Err(_) => return error_answer(None, 400, "BadRequest", "request body is not valid JSON"),
+        }
+    };
+    let request_id = parsed
+        .get("requestId")
+        .and_then(Value::as_str)
+        .map(str::to_owned);
+
+    match (method, path.as_str()) {
+        (tiny_http::Method::Get, "/health") => (200, json!({ "ok": true })),
+
+        // The recorded WAV, base64-wrapped so the JSON surface stays uniform.
+        // The standalone bridge decodes it and forwards the bytes to the
+        // configured cloud transcription provider (Groq / OpenAI wire).
+        (tiny_http::Method::Post, "/audio") => {
+            let Some(recording_id) = parsed.get("recordingId").and_then(Value::as_str) else {
+                return error_answer(
+                    request_id.as_deref(),
+                    400,
+                    "BadRequest",
+                    "recordingId is required",
+                );
+            };
+            match crate::recorder::blob::read_blob_bytes(app, recording_id) {
+                Ok(bytes) => (
+                    200,
+                    json!({
+                        "requestId": request_id,
+                        "recordingId": recording_id,
+                        "contentType": "audio/wav",
+                        "audioBase64": base64::engine::general_purpose::STANDARD.encode(&bytes),
+                    }),
+                ),
+                Err(error) => recorder_answer(request_id.as_deref().unwrap_or(""), &error),
+            }
+        }
+
+        (tiny_http::Method::Post, "/start") => start(app, &parsed),
+        (tiny_http::Method::Post, "/stop") => stop(app, &parsed),
+        (tiny_http::Method::Post, "/cancel") => cancel(app, &parsed),
+
+        _ => error_answer(
+            request_id.as_deref(),
+            404,
+            "NotFound",
+            "unknown route; the surface is /health /start /stop /cancel /audio /transcribe-cloud is served by the standalone bridge",
+        ),
+    }
+}
+
+// ── The recording endpoints ─────────────────────────────────────────────
+//
+// Each one mirrors the shape of the matching Tauri command in
+// `recorder::commands` — same lock discipline, same ownership label, same
+// indicator refresh — with `OWNER_LABEL` standing in for a window label.
+
+fn start(app: &AppHandle, body: &Value) -> Answer {
+    let Some(request_id) = str_field(body, "requestId") else {
+        return error_answer(None, 400, "BadRequest", "requestId is required");
+    };
+    let device = body
+        .get("deviceIdentifier")
+        .and_then(Value::as_str)
+        .map(str::to_owned);
+
+    let audio_blob_id = match crate::recorder::blob::mint_blob_id() {
+        Ok(id) => id,
+        Err(error) => return recorder_answer(&request_id, &error),
+    };
+
+    let recorder = app.state::<std::sync::Mutex<crate::recorder::recorder::Recorder>>();
+    let started = {
+        let mut guard = match recorder.lock() {
+            Ok(guard) => guard,
+            Err(error) => {
+                return error_answer(
+                    Some(&request_id),
+                    500,
+                    "Internal",
+                    format!("recorder lock poisoned: {error}"),
+                )
+            }
+        };
+        guard.start(device.as_deref(), audio_blob_id.clone(), OWNER_LABEL.to_owned(), app.clone())
+    };
+    crate::recorder::commands::refresh_recording_indicator(app);
+
+    match started {
+        Ok(host_recording) => {
+            let device = match serde_json::to_value(&host_recording.device) {
+                Ok(value) => value,
+                Err(_) => json!(null),
+            };
+            (
+                200,
+                json!({
+                    "requestId": request_id,
+                    "recordingId": host_recording.audio_blob_id,
+                    "device": device,
+                }),
+            )
+        }
+        Err(error) => recorder_answer(&request_id, &error),
+    }
+}
+
+fn stop(app: &AppHandle, body: &Value) -> Answer {
+    let Some(request_id) = str_field(body, "requestId") else {
+        return error_answer(None, 400, "BadRequest", "requestId is required");
+    };
+    let Some(recording_id) = str_field(body, "recordingId") else {
+        return error_answer(Some(&request_id), 400, "BadRequest", "recordingId is required");
+    };
+
+    let recorder = app.state::<std::sync::Mutex<crate::recorder::recorder::Recorder>>();
+    let stopped = {
+        let mut guard = match recorder.lock() {
+            Ok(guard) => guard,
+            Err(error) => {
+                return error_answer(
+                    Some(&request_id),
+                    500,
+                    "Internal",
+                    format!("recorder lock poisoned: {error}"),
+                )
+            }
+        };
+        // The ownership check means a recording the bridge did not start is
+        // refused here with the same typed `NotRecording` a window would get:
+        // the bridge can never stop a Whispering-window recording, and vice
+        // versa.
+        guard.stop(&recording_id, OWNER_LABEL)
+    };
+    crate::recorder::commands::refresh_recording_indicator(app);
+
+    let finalized = match stopped {
+        Ok(finalized) => finalized,
+        Err(error) => return recorder_answer(&request_id, &error),
+    };
+    match finalized.publish() {
+        Ok(recorded) => (
+            200,
+            json!({
+                "requestId": request_id,
+                "recordingId": recording_id,
+                "durationMs": recorded.duration_ms,
+                "byteLength": recorded.byte_length,
+            }),
+        ),
+        Err(error) => recorder_answer(&request_id, &error),
+    }
+}
+
+fn cancel(app: &AppHandle, body: &Value) -> Answer {
+    let Some(request_id) = str_field(body, "requestId") else {
+        return error_answer(None, 400, "BadRequest", "requestId is required");
+    };
+    let Some(recording_id) = str_field(body, "recordingId") else {
+        return error_answer(Some(&request_id), 400, "BadRequest", "recordingId is required");
+    };
+
+    let recorder = app.state::<std::sync::Mutex<crate::recorder::recorder::Recorder>>();
+    let cancelled = match recorder.lock() {
+        Ok(mut guard) => guard.cancel(&recording_id, OWNER_LABEL),
+        Err(error) => {
+            return error_answer(
+                Some(&request_id),
+                500,
+                "Internal",
+                format!("recorder lock poisoned: {error}"),
+            )
+        }
+    };
+    crate::recorder::commands::refresh_recording_indicator(app);
+
+    match cancelled {
+        Ok(()) => (200, json!({ "requestId": request_id })),
+        Err(error) => recorder_answer(&request_id, &error),
+    }
+}
+
+// ── The fence, body cap, and error mapping ──────────────────────────────
+
+fn authorize(request: &tiny_http::Request) -> Result<(), Answer> {
+    // DNS-rebinding fence: a rebinding page would arrive with a hostile Host
+    // (an attacker domain resolving to 127.0.0.1) or with a private-IP Host.
+    let expected_host = match server_host(request) {
+        Some(host) => host,
+        None => return Err(error_answer(None, 403, "Forbidden", "missing Host header")),
+    };
+    let has_host = request
+        .headers()
+        .iter()
+        .any(|header| header.field.equiv("Host") && header.value.as_str().trim() == expected_host);
+    if !has_host {
+        return Err(error_answer(
+            None,
+            403,
+            "Forbidden",
+            "Host header must be 127.0.0.1 on this port",
+        ));
+    }
+
+    // Bearer credential, compared in constant time. A wrong or missing token
+    // is the same answer either way.
+    let token = super::current_token();
+    let presented = request
+        .headers()
+        .iter()
+        .find(|header| header.field.equiv("Authorization"))
+        .map(|header| header.value.as_str().trim().to_owned())
+        .and_then(|value| value.strip_prefix("Bearer ").map(str::to_owned));
+    let matches = match presented {
+        Some(presented) => constant_time_eq(presented.as_bytes(), token.as_bytes()),
+        None => false,
+    };
+    if !matches {
+        return Err(error_answer(
+            None,
+            401,
+            "AuthFailed",
+            "missing or invalid bearer token",
+        ));
+    }
+    Ok(())
+}
+
+/// The `127.0.0.1:<port>` string this surface answers on, taken from the
+/// listener's own socket address.
+static SERVER_ADDR: std::sync::OnceLock<String> = std::sync::OnceLock::new();
+
+pub(crate) fn store_server_addr(addr: String) {
+    let _ = SERVER_ADDR.set(addr);
+}
+
+fn server_host(_request: &tiny_http::Request) -> Option<String> {
+    SERVER_ADDR.get().cloned()
+}
+
+fn read_body(request: &mut tiny_http::Request) -> Result<Vec<u8>, Answer> {
+    let mut buffer = Vec::new();
+    let mut reader = request.as_reader().take(MAX_BODY_BYTES + 1);
+    reader
+        .read_to_end(&mut buffer)
+        .map_err(|_| error_answer(None, 400, "BadRequest", "failed to read the request body"))?;
+    if buffer.len() as u64 > MAX_BODY_BYTES {
+        return Err(error_answer(
+            None,
+            413,
+            "PayloadTooLarge",
+            "request body exceeds the limit",
+        ));
+    }
+    Ok(buffer)
+}
+
+/// Constant-time equality so a wrong token costs the same as a nearly-right
+/// one. `u8` xor fold; no early exit on the secret's bytes.
+fn constant_time_eq(a: &[u8], b: &[u8]) -> bool {
+    if a.len() != b.len() {
+        return false;
+    }
+    let mut diff = 0_u8;
+    for (x, y) in a.iter().zip(b.iter()) {
+        diff |= x ^ y;
+    }
+    diff == 0
+}
+
+fn str_field(body: &Value, name: &str) -> Option<String> {
+    body.get(name).and_then(Value::as_str).map(str::to_owned)
+}
+
+fn error_answer(request_id: Option<&str>, status: u16, code: &str, message: impl Into<String>) -> Answer {
+    (
+        status,
+        json!({
+            "requestId": request_id,
+            "error": { "code": code, "message": message.into() },
+        }),
+    )
+}
+
+fn recorder_answer(request_id: &str, error: &crate::recorder::error::RecorderError) -> Answer {
+    use crate::recorder::error::RecorderError;
+    let (status, code) = match error {
+        RecorderError::Busy { .. } => (409, "Busy"),
+        RecorderError::NotRecording { .. } => (409, "NotRecording"),
+        RecorderError::NoInputDevice { .. } => (503, "NoInputDevice"),
+        RecorderError::PermissionDenied { .. } => (503, "MicPermissionDenied"),
+        RecorderError::Failed { .. } => (500, "RecorderFailed"),
+    };
+    error_answer(Some(request_id), status, code, error.to_string())
+}
